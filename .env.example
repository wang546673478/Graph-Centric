# Graph-Centric Agent Harness — environment template
#
# Copy this file to `.env` (it's git-ignored) and fill in real values.
# Loaded automatically on `cargo run --bin <anything>` via dotenvy.

# ----- Required -----

# OpenAI-compatible base URL. Must end in /v1 (our client appends /chat/completions).
# Examples:
#   DeepSeek: https://api.deepseek.com/v1
#   OpenAI:   https://api.openai.com/v1
#   Ollama:   http://localhost:11434/v1
#   vLLM:     http://localhost:8000/v1
MODEL_BASE_URL=https://api.deepseek.com/v1

# Bearer token. Leave blank for unauthenticated backends (most local servers).
MODEL_API_KEY=sk-REPLACE_ME

# ----- Tiered model selection -----
#
# Pick ONE of the following two patterns:
#
# (a) Single-model setup — both tiers resolve to the same model:
MODEL_NAME_DEFAULT=deepseek-v4-pro

# (b) OR split tiers — uncomment these and remove MODEL_NAME_DEFAULT above:
# MODEL_NAME_FAST=deepseek-v4-flash      # used by Proposer + Verifier (high volume)
# MODEL_NAME_DEEP=deepseek-v4-pro        # used by L1Enricher + LocalRepairer (quality)
#
# Note: DeepSeek's native API accepts only bare model names
# (deepseek-v4-pro, deepseek-v4-flash). Don't append [1m] or similar
# suffixes — those are Claude-Code-wrapper conventions, not the API's.
# Both model variants serve 1M context out of the box.

# ----- Optional -----

# Rust tracing filter. `info` is sensible; `debug` for verbose loop / tool tracing.
RUST_LOG=info
